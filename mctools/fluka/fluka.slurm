#!/usr/bin/env bash
#SBATCH --job-name=fluka
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --output=fluka-%A_%a.log
#SBATCH --time=7-00:00:00

# Outside of a SLURM job: submit one array task per input file
if [ -z "$SLURM_JOB_ID" ]; then
    if [ $# -lt 1 ]; then
	echo "FLUKA SLURM job submitter"
	echo "      submits each FLUKA input file as a separate task of a SLURM job array"
	echo ""
	echo "Usage: $(basename $0) INP [INP ...]"
	echo " INP   FLUKA input file(s), e.g. generated by fluka-reseed"
	echo ""
	echo "Environment variables:"
	echo " NCYCLES    number of FLUKA cycles per job (default: 1)"
	echo " FLUKA_EXE  FLUKA executable passed to rfluka -e (default: standard FLUKA)"
	echo " SBATCH_*   standard sbatch input variables, e.g. SBATCH_PARTITION, SBATCH_TIMELIMIT"
	echo ""
	echo "Homepage: https://github.com/kbat/mc-tools"
	exit 1
    fi

    for INP in "$@"; do
	if [ ! -e "$INP" ]; then
	    echo "Can't open $INP"
	    exit 2
	fi
    done

    if [ -z "$FLUPRO" ]; then
	echo "FLUPRO is not set"
	exit 3
    fi

    exec sbatch --array=1-$# --export=ALL "$(readlink -f "$0")" "$@"
fi

# Inside the SLURM job: run the input file of this array task
ARGS=("$@")
INP=${ARGS[$((SLURM_ARRAY_TASK_ID - 1))]}
NCYCLES=${NCYCLES:-1}

echo "$(date): task $SLURM_ARRAY_TASK_ID on $(hostname): $INP ($NCYCLES cycle(s))"

if [ -n "$FLUKA_EXE" ]; then
    $FLUPRO/flutil/rfluka -e "$FLUKA_EXE" -N0 -M$NCYCLES "$INP"
else
    $FLUPRO/flutil/rfluka -N0 -M$NCYCLES "$INP"
fi
STATUS=$?

echo ""
echo "$(date): $INP finished with exit status $STATUS"
exit $STATUS
